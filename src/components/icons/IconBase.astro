---
/** Shared 24×24 stroke-icon frame; the icon's shapes go in the slot. */
interface Props {
  size?: number;
}

const { size = 20 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <slot />
</svg>
