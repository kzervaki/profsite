---
import TextWithImage from "@/components/content/TextWithImage.astro";
import SitePage from "@/components/layout/SitePage.astro";
import ServiceCard from "@/components/services/ServiceCard.astro";
import ServiceGrid from "@/components/services/ServiceGrid.astro";
import { APPROACHES, approachHref } from "@/data/approaches";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/utils/paths";
---

<BaseLayout title="Θεραπευτικές προσεγγίσεις">
  <SitePage title="Θεραπευτικές προσεγγίσεις">
    <TextWithImage
      imageSrc={withBase("images/intro-image-2.webp")}
      imageAlt="Sample image"
      imagePosition="top-left"
      textAlignment="justify"
      imageMargin="33px"
      imageWidth="390px"
      roundedCorners={true}
      mobileSpacing="1.5rem"
      mobileImageWidth="80%"
    >
      <p>

        Η θεραπευτική μου προσέγγιση είναι συνθετική, αντλώντας κυρίαρχα
        θεωρητικά εργαλεία και κλινική γνώση από τη Συστημική Ψυχοθεραπεία και τη
        Διαλεκτική Συμπεριφορική Ψυχοθεραπεία (DBT). Παράλληλα, ενσωματώνει εκλεκτικά
        στοιχεία  της ψυχοδυναμικής οπτικής, της θεωρίας των αντικειμενοτρόπων σχέσεων
        και της θεωρίας δεσμού, το γνωσιακό-συμπεριφορικό μοντέλο, αλλά και από τις
        σύγχρονες προσεγγίσεις της τραυματολογίας. Μέσα από αυτή τη σύνθεση, δίνεται
        έμφαση τόσο στη σχεσιακή, κυκλική διάσταση των δυσκολιών, όσο και στην
        κατανόηση ασυνείδητων διεργασιών και βιοψυχοκοινωνικών επιρροών, με γνώμονα την
        ανάπτυξη ασφαλέστερων  και λειτουργικών τρόπων σύνδεσης με τον εαυτό και τους
        άλλους. Εάν διανύετε μια περίοδο συναισθηματικής έντασης, προσωπικών δυσκολιών
        ή επαναλαμβανόμενων προκλήσεων στις σχέσεις σας, η ψυχοθεραπεία μπορεί να
        αποτελέσει ένα ασφαλές και σταθερό σημείο υποστήριξης και ένα εφαλτήριο
        προσωπικής εξέλιξης.
      
      </p>
    </TextWithImage>

    <ServiceGrid columns={2}>
      {APPROACHES.map((approach) => (
        <ServiceCard
          title={approach.title}
          description={approach.description}
          href={approachHref(approach)}
          height="120px"
        />
      ))}
    </ServiceGrid>
  </SitePage>
</BaseLayout>
