---
import { CONFIG } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BASE_URL } from "@/utils/paths";
---

<BaseLayout title="Page not found">
  <section class="not-found">
    <!-- Breadcrumb hint (desktop only) -->
    <div class="not-found-breadcrumb">
      <a href={BASE_URL}>{CONFIG.siteTitle}</a> / 404
    </div>

    <h1 class="not-found-number" aria-label="404 error">404</h1>

    <h1 class="not-found-lead">
      Η σελίδα που ψάχνετε δεν υπάρχει
    </h1>

    <a href={BASE_URL} class="not-found-link">
      Επιστροφή στην αρχική
    </a>
  </section>
</BaseLayout>
