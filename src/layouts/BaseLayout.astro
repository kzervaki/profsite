---
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteNav from "@/components/layout/SiteNav.astro";
import { CONFIG } from "@/config/site";
import { withBase } from "@/utils/paths";

interface Props {
  /** Page title; defaults to a breadcrumb built from the URL path */
  title?: string;
  faviconSize?: string;
}

const { title, faviconSize = "32x32" } = Astro.props;

// e.g. "/services/family-therapy" → "Services · Family Therapy"
const capitalizeWords = (segment: string) => segment
  .replace(/-/g, " ")
  .replace(/\b\w/g, (c) => c.toUpperCase());

const breadcrumbTitle = Astro.url.pathname
  .split("/")
  .filter(Boolean)
  .map(capitalizeWords)
  .join(" · ");

const siteName = `${CONFIG.fullName} – ${CONFIG.profession}`;
const pageSuffix = title || breadcrumbTitle;
const pageTitle = pageSuffix ? `${pageSuffix} · ${siteName}` : siteName;

const logoSrc = withBase("images/logo-kzervaki.png");
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" href={logoSrc} sizes={faviconSize} />
    <link rel="stylesheet" href={withBase("styles/global.css")}>
  </head>

  <body>
    <SiteHeader logoSrc={logoSrc} />
    <SiteNav />

    <main class="site-main" data-theme="theme-sage">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
